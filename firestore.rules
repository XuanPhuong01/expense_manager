rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function validWalletInfo(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.type in ['cash', 'bank'];
    }

    function transactionPath(userId, transactionId) {
      return /databases/$(database)/documents/users/$(userId)/transactions/$(transactionId);
    }

    function walletPath(userId, walletId) {
      return /databases/$(database)/documents/users/$(userId)/wallets/$(walletId);
    }

    function signedAmount(data) {
      return data.type == 'expense' ? -data.amount : data.amount;
    }

    function validTransactionFields(data) {
      return data.keys().hasOnly([
          'walletId', 'type', 'amount',
          'category', 'note', 'createdAt'
        ])
        && data.keys().hasAll([
          'walletId', 'type', 'amount',
          'category', 'note', 'createdAt'
        ])
        && data.walletId is string
        && data.type in ['expense', 'income']
        && data.amount is int
        && data.amount > 0
        && data.amount <= 999999999999
        && data.category is string
        && data.category.size() > 0
        && data.category.size() <= 40
        && data.note is string
        && data.note.size() <= 200
        && data.createdAt is timestamp;
    }

    function validTransaction(data) {
      return validTransactionFields(data)
        && data.createdAt == request.time;
    }

    function walletCorrectForEditedTransaction(userId, transactionId, oldData, newData) {
      return oldData.walletId == newData.walletId
        && exists(walletPath(userId, oldData.walletId))
        && getAfter(walletPath(userId, oldData.walletId)).data.lastTransactionId == transactionId
        && getAfter(walletPath(userId, oldData.walletId)).data.updatedAt == request.time
        && getAfter(walletPath(userId, oldData.walletId)).data.balance ==
          get(walletPath(userId, oldData.walletId)).data.balance
          - signedAmount(oldData) + signedAmount(newData);
    }

    function walletCorrectForDeletedTransaction(userId, transactionId, oldData) {
      return exists(walletPath(userId, oldData.walletId))
        && getAfter(walletPath(userId, oldData.walletId)).data.lastTransactionId == transactionId
        && getAfter(walletPath(userId, oldData.walletId)).data.updatedAt == request.time
        && getAfter(walletPath(userId, oldData.walletId)).data.balance ==
          get(walletPath(userId, oldData.walletId)).data.balance
          - signedAmount(oldData);
    }

    // WALLETS
    match /users/{userId}/wallets/{walletId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'name', 'type', 'initialBalance',
          'balance', 'currency', 'createdAt'
        ])
        && validWalletInfo(request.resource.data)
        && request.resource.data.initialBalance is int
        && request.resource.data.initialBalance >= 0
        && request.resource.data.initialBalance <= 999999999999
        && request.resource.data.balance
          == request.resource.data.initialBalance
        && request.resource.data.currency == 'VND'
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(userId)
        && (
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['name', 'type', 'updatedAt'])
            && validWalletInfo(request.resource.data)
            && request.resource.data.updatedAt == request.time
          )
          ||
          (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['balance', 'updatedAt', 'lastTransactionId'])
            && request.resource.data.lastTransactionId is string
            && request.resource.data.updatedAt == request.time
            && request.resource.data.balance is int
            && (
              // THÊM: giao dịch mới tăng/giảm số dư.
              (
                !exists(transactionPath(userId, request.resource.data.lastTransactionId))
                && existsAfter(transactionPath(userId, request.resource.data.lastTransactionId))
                && getAfter(transactionPath(userId, request.resource.data.lastTransactionId)).data.walletId == walletId
                && request.resource.data.balance ==
                  resource.data.balance +
                  signedAmount(getAfter(transactionPath(userId, request.resource.data.lastTransactionId)).data)
              )
              ||
              // SỬA: hoàn tác giá trị cũ rồi áp dụng giá trị mới.
              (
                exists(transactionPath(userId, request.resource.data.lastTransactionId))
                && existsAfter(transactionPath(userId, request.resource.data.lastTransactionId))
                && get(transactionPath(userId, request.resource.data.lastTransactionId)).data.walletId == walletId
                && getAfter(transactionPath(userId, request.resource.data.lastTransactionId)).data.walletId == walletId
                && request.resource.data.balance ==
                  resource.data.balance
                  - signedAmount(get(transactionPath(userId, request.resource.data.lastTransactionId)).data)
                  + signedAmount(getAfter(transactionPath(userId, request.resource.data.lastTransactionId)).data)
              )
              ||
              // XÓA: hoàn tác giá trị của giao dịch cũ.
              (
                exists(transactionPath(userId, request.resource.data.lastTransactionId))
                && !existsAfter(transactionPath(userId, request.resource.data.lastTransactionId))
                && get(transactionPath(userId, request.resource.data.lastTransactionId)).data.walletId == walletId
                && request.resource.data.balance ==
                  resource.data.balance
                  - signedAmount(get(transactionPath(userId, request.resource.data.lastTransactionId)).data)
              )
            )
          )
        );

      allow delete: if false;
    }

    // TRANSACTIONS
    match /users/{userId}/transactions/{transactionId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId)
        && validTransaction(request.resource.data)
        && exists(walletPath(
          userId, request.resource.data.walletId
        ))
        && getAfter(walletPath(
          userId, request.resource.data.walletId
        )).data.lastTransactionId == transactionId
        && getAfter(walletPath(
          userId, request.resource.data.walletId
        )).data.balance ==
          get(walletPath(
            userId, request.resource.data.walletId
          )).data.balance + signedAmount(request.resource.data)
        && getAfter(walletPath(
          userId, request.resource.data.walletId
        )).data.updatedAt == request.time;

      // Không được chuyển ví hoặc đổi ngày tạo trong bản sửa này.
      allow update: if isOwner(userId)
        && validTransactionFields(request.resource.data)
        && request.resource.data.walletId == resource.data.walletId
        && request.resource.data.createdAt == resource.data.createdAt
        && walletCorrectForEditedTransaction(
          userId, transactionId, resource.data, request.resource.data
        );

      allow delete: if isOwner(userId)
        && walletCorrectForDeletedTransaction(
          userId, transactionId, resource.data
        );

    }

    // BUDGETS
    match /users/{userId}/budgets/{budgetId} {
      allow read: if isOwner(userId);

      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'month', 'categoryKey', 'limit', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'month', 'categoryKey', 'limit', 'updatedAt'
        ])
        && request.resource.data.month is string
        && request.resource.data.month.matches(
          '^20[0-9]{2}-(0[1-9]|1[0-2])$'
        )
        && request.resource.data.categoryKey in [
          'food', 'transport', 'shopping',
          'education', 'health', 'other'
        ]
        && budgetId == request.resource.data.month
          + '_' + request.resource.data.categoryKey
        && request.resource.data.limit is int
        && request.resource.data.limit >= 1000
        && request.resource.data.limit <= 999999999999
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(userId);
    }
  }
}
