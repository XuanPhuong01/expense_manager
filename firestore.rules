
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function validWalletInfo(data) {
      return data.name is string
        && data.name.size() > 0
        && data.name.size() <= 40
        && data.type in ['cash', 'bank'];
    }

    match /users/{userId}/wallets/{walletId} {

      // Chi chu tai khoan duoc xem vi
      allow read: if isOwner(userId);

      // Tao vi moi
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll([
          'name', 'type', 'initialBalance',
          'balance', 'currency', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'type', 'initialBalance',
          'balance', 'currency', 'createdAt'
        ])
        && validWalletInfo(request.resource.data)
        && request.resource.data.initialBalance is int
        && request.resource.data.initialBalance >= 0
        && request.resource.data.initialBalance <= 999999999999
        && request.resource.data.balance
             == request.resource.data.initialBalance
        && request.resource.data.currency == 'VND'
        && request.resource.data.createdAt == request.time;

      // Chi duoc sua ten, loai vi va thoi gian cap nhat
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly(['name', 'type', 'updatedAt'])
        && validWalletInfo(request.resource.data)
        && request.resource.data.updatedAt == request.time;

      // Chua cho phep xoa vi
      allow delete: if false;
    }
  }
}
